{
	"name": "core",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "$npm_execpath run build && vite preview",
		"deploy": "$npm_execpath run build && wrangler deploy",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"db:migrate": "atlas migrate diff --env local",
		"db:apply": "atlas migrate apply --env local",
		"db:status": "atlas migrate status --env local"
	},
	"dependencies": {
		"arktype": "^2.1.29",
		"hono": "^4.11.3",
		"hono-openapi": "^1.1.2",
		"hono-rate-limiter": "^0.5.3",
		"ksuid": "^3.0.0",
		"kysely": "^0.28.9",
		"kysely-d1": "^0.4.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.2.3",
		"vite": "npm:rolldown-vite@^7.3.0",
		"vite-ssr-components": "^0.5.2",
		"wrangler": "^4.56.0"
	}
}
